{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "files": [
    "./src/server.ts",
    "./src/config/database.ts",
    "./src/controllers/authController.ts",
    "./src/routes/auth.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "client"
  ]
}